# انسخ هذا الملف باسم .env وعدّل القيم قبل التشغيل
# Copy this file to .env and edit the values before running.

PORT=3000
NODE_ENV=development

# مفتاح سري لتوقيع جلسات الدخول (JWT). يجب أن يكون طويلاً وعشوائياً في الإنتاج.
# Secret used to sign login session tokens. Use a long random value in production.
# You can generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-secret

# مسار ملف قاعدة البيانات (SQLite) — اختياري
# DB_PATH=./data/platform.db

# بيانات حساب المدير الأول اللي بينعمل عند تشغيل seed لأول مرة
# Credentials for the first super-admin account created by `npm run seed`
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=ChangeMe123!
