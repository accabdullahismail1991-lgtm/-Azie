# انسخ هذا الملف باسم .env وعدّل القيم قبل التشغيل
# Copy this file to .env and edit the values before running.

PORT=3000
NODE_ENV=development

# رابط الاتصال بقاعدة بيانات PostgreSQL. استخدم قاعدة بيانات مجانية مُدارة
# مثل Neon أو Supabase (راجع README.md لخطوات الإنشاء)، أو Postgres محلي للتطوير.
# Connection string for a PostgreSQL database. Use a free managed database
# such as Neon or Supabase (see README.md), or a local Postgres for dev.
# Example (Neon):   postgresql://user:password@ep-xxxx.neon.tech/dbname?sslmode=require
# Example (local):  postgresql://postgres:postgres@localhost:5432/azie_platform
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/azie_platform

# مفتاح سري لتوقيع جلسات الدخول (JWT). يجب أن يكون طويلاً وعشوائياً في الإنتاج.
# Secret used to sign login session tokens. Use a long random value in production.
# You can generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-secret

# بيانات حساب المدير الأول اللي بينعمل عند تشغيل seed لأول مرة
# Credentials for the first super-admin account created by `npm run seed`
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=ChangeMe123!

# اختياري — لتفعيل ميزة "إرسال بالإيميل" (مثلاً بدفتر التدفقات النقدية).
# سجّل حساب مجاني على https://resend.com وخذ الـ API Key من لوحة التحكم.
# بدون هذا المتغير، زر الإرسال بالإيميل بيرجع رسالة خطأ واضحة بدل ما يفشل بصمت.
# Optional — enables the "email report" feature (e.g. in the cash flow ledger).
# Sign up free at https://resend.com and grab an API key from the dashboard.
# Without this set, the email-send button returns a clear error instead of failing silently.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# عنوان "المرسل" الظاهر بالإيميل. بدون توثيق نطاق (domain) خاص فيك على Resend،
# خلّيه القيمة الافتراضية onboarding@resend.dev — بس هذا العنوان التجريبي بيقدر
# يرسل بس لبريدك الشخصي (المسجّل فيه حساب Resend)، مش لأي عنوان تاني، لحد ما توثّق نطاق.
# The "from" address shown on the email. Without your own verified domain on
# Resend, leave this as the default onboarding@resend.dev — that sandbox
# address can only send TO your own Resend account email until you verify a domain.
# RESEND_FROM_EMAIL=المنصة الموحدة <onboarding@resend.dev>
